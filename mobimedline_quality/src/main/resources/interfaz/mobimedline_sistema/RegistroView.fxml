<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane minHeight="550.0" minWidth="850.0" prefHeight="650.0" prefWidth="950.0" styleClass="root-container" stylesheets="@Estilos/Estilos_Interfaz.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="interfaz.mobimedline_sistema.RegistroController">
   <children>
      <!-- Contenedor Principal Centrado para Evitar Deformaciones -->
      <StackPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            
            <!-- Tarjeta Dividida en 2 Columnas -->
            <GridPane maxHeight="580.0" maxWidth="880.0" styleClass="split-card" StackPane.alignment="CENTER">
              <columnConstraints>
                <!-- Columna Izquierda: Panel Informativo (40%) -->
                <ColumnConstraints hgrow="ALWAYS" percentWidth="40.0" />
                <!-- Columna Derecha: Formulario de Registro (60%) -->
                <ColumnConstraints hgrow="ALWAYS" percentWidth="60.0" />
              </columnConstraints>
              <rowConstraints>
                <RowConstraints vgrow="ALWAYS" />
              </rowConstraints>
               <children>
                  
                  <!-- PANEL IZQUIERDO (Banner Visual con Paleta Mobimedline) -->
                  <VBox alignment="CENTER_LEFT" spacing="15.0" styleClass="left-banner" GridPane.columnIndex="0">
                     <children>
                        <Label styleClass="banner-badge" text="REGISTRO DE USUARIO" />
                        <Label styleClass="banner-title" text="Bienvenido a Mobimedline" wrapText="true" />
                        <Label styleClass="banner-desc" text="Crea tu cuenta para gestionar órdenes de compra y acceder a las herramientas criptográficas de la plataforma." wrapText="true" />
                     </children>
                     <padding>
                        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
                     </padding>
                  </VBox>

                  <!-- PANEL DERECHO (Formulario de Registro) -->
                  <VBox alignment="CENTER_LEFT" spacing="14.0" styleClass="right-form-panel" GridPane.columnIndex="1">
                     <children>
                        
                        <!-- Header del Formulario y Botón de Volver -->
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <VBox HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label styleClass="form-title" text="Crear una Cuenta" />
                                    <Label styleClass="form-subtitle" text="Ingresa tus datos para solicitar acceso al sistema" />
                                 </children>
                              </VBox>
                              <Hyperlink fx:id="linkVolverLogin" onAction="#IrLogin" styleClass="back-link" text="← Volver al Login" />
                           </children>
                           <VBox.margin>
                              <Insets bottom="5.0" />
                           </VBox.margin>
                        </HBox>

                        <!-- Fila 1: Nombre y Apellidos (Distribución Doble) -->
                        <HBox spacing="12.0">
                           <children>
                              <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label styleClass="input-label" text="Nombre:" />
                                    <TextField fx:id="txtNombre" promptText="Ej. Carlos" styleClass="custom-input" />
                                 </children>
                              </VBox>
                              <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label styleClass="input-label" text="Apellidos:" />
                                    <TextField fx:id="txtApellidos" promptText="Ej. Mendoza Ruiz" styleClass="custom-input" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>

                        <!-- Fila 2: Correo Electrónico -->
                        <VBox spacing="4.0">
                           <children>
                              <Label styleClass="input-label" text="Correo Electrónico:" />
                              <TextField fx:id="txtCorreo" promptText="cmendoza@mobimedline.com" styleClass="custom-input" />
                           </children>
                        </VBox>

                        <!-- Fila 3: Número Telefónico -->
                        <VBox spacing="4.0">
                           <children>
                              <Label styleClass="input-label" text="Número Telefónico:" />
                              <TextField fx:id="txtTelefono" promptText="5512345678" styleClass="custom-input" />
                           </children>
                        </VBox>

                        <!-- Fila 4: Contraseña y Confirmación -->
                        <HBox spacing="12.0">
                           <children>
                              <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label styleClass="input-label" text="Contraseña:" />
                                    <PasswordField fx:id="txtPassword" promptText="••••••••" styleClass="custom-input" />
                                 </children>
                              </VBox>
                              <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label styleClass="input-label" text="Confirmación:" />
                                    <PasswordField fx:id="txtConfirmPassword" promptText="••••••••" styleClass="custom-input" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>

                        <!-- Botón Aceptar / Solicitar Registro -->
                        <Button fx:id="btnSolicitarRegistro" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#accionSolicitarRegistro" styleClass="btn-primary" text="SOLICITAR REGISTRO">
                           <VBox.margin>
                              <Insets top="8.0" />
                           </VBox.margin>
                        </Button>

                        <!-- Nota Aclaratoria Inferior -->
                        <Label styleClass="disclaimer-text" text="* Tu solicitud será revisada por un Administrador antes de activarse." wrapText="true">
                           <VBox.margin>
                              <Insets top="2.0" />
                           </VBox.margin>
                        </Label>

                     </children>
                     <padding>
                        <Insets bottom="30.0" left="35.0" right="35.0" top="30.0" />
                     </padding>
                  </VBox>

               </children>
            </GridPane>

         </children>
      </StackPane>
   </children>
</AnchorPane>
