<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<AnchorPane minHeight="500.0" minWidth="800.0" prefHeight="600.0" prefWidth="900.0" styleClass="root-container" stylesheets="@Estilos/Estilos_Interfaz.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="interfaz.mobimedline_sistema.IniciarSesController">
   <children>
      <!-- Contenedor Principal Centrado para Responsividad -->
      <StackPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            
            <VBox alignment="CENTER" maxWidth="420.0" spacing="0.0">
               <children>
                  
                  <!-- Ícono Superior Flotante -->
                  <StackPane maxHeight="70.0" minHeight="70.0">
                     <children>
                        <Circle radius="38.0" styleClass="avatar-circle" visible="false" />
                        <Label styleClass="avatar-icon" text="👤" visible="false" />
                     </children>
                     <VBox.margin>
                        <Insets bottom="-35.0" />
                     </VBox.margin>
                  </StackPane>

                  <!-- Tarjeta Central Principal -->
                  <VBox spacing="15.0" styleClass="login-card">
                     <children>
                        <!-- Encabezado -->
                        <VBox alignment="CENTER" spacing="2.0">
                           <children>
                              <Label styleClass="card-title" text="ACCESO AL SISTEMA" />
                              <Label styleClass="card-subtitle" text="Mobimedline" />
                           </children>
                           <VBox.margin>
                              <Insets bottom="10.0" top="25.0" />
                           </VBox.margin>
                        </VBox>

                        <!-- Campo Usuario -->
                        <VBox spacing="5.0">
                           <children>
                              <Label styleClass="input-label" text="Usuario" />
                              <HBox alignment="CENTER_LEFT" styleClass="input-box">
                                 <children>
                                    <Label styleClass="input-icon" text="👤" />
                                    <TextField fx:id="tfnombreUs" promptText="Nombre de usuario" styleClass="transparent-tf" HBox.hgrow="ALWAYS" />
                                 </children>
                              </HBox>
                           </children>
                        </VBox>

                        <!-- Campo Contraseña -->
                        <VBox spacing="5.0">
                           <children>
                              <Label styleClass="input-label" text="Contraseña" />
                              <HBox alignment="CENTER_LEFT" styleClass="input-box">
                                 <children>
                                    <Label styleClass="input-icon" text="🔒" />
                                    <PasswordField fx:id="passfiCon" promptText="••••••••" styleClass="transparent-tf" HBox.hgrow="ALWAYS" />
                                 </children>
                              </HBox>
                           </children>
                        </VBox>

                        <!-- Opciones: Recordar Usuario y Olvidé Contraseña -->
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <HBox alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Hyperlink fx:id="linkOlvidePassword" styleClass="custom-link" text="¿Olvidaste tu contraseña?" />
                                 </children>
                              </HBox>
                           </children>
                           <VBox.margin>
                              <Insets top="5.0" />
                           </VBox.margin>
                        </HBox>

                        <!-- Botón Principal INICIAR SESIÓN -->
                        <Button fx:id="buttonIniciSes" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleLogin" styleClass="btn-login" text="INICIAR SESIÓN">
                           <VBox.margin>
                              <Insets top="10.0" />
                           </VBox.margin>
                        </Button>
                     </children>
                     <padding>
                        <Insets bottom="25.0" left="30.0" right="30.0" top="10.0" />
                     </padding>
                  </VBox>

                  <!-- Enlace Inferior para Registrarse -->
                  <HBox alignment="CENTER" spacing="5.0">
                     <children>
                        <Label styleClass="footer-text" text="¿No tienes una cuenta?" />
                        <Hyperlink fx:id="linkRegistrar" onAction="#IrRegistro" styleClass="custom-link-bold" text="Registrarse" />
                     </children>
                     <VBox.margin>
                        <Insets top="20.0" />
                     </VBox.margin>
                  </HBox>

               </children>
            </VBox>

         </children>
      </StackPane>
   </children>
</AnchorPane>
